# Application
APP_NAME=Paper2Project
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# FastAPI
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://paper2project.vercel.app

# Firebase (dumpareviews project)
FIREBASE_PROJECT_ID=dumpareviews
FIREBASE_SERVICE_ACCOUNT_KEY=./firebase-service-account.json

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenRouter (Recommended: Free Qwen 2.5 72B & Coder 32B)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct:free
OPENROUTER_FALLBACK_MODELS=["qwen/qwen-2.5-coder-32b-instruct:free","meta-llama/llama-3.3-70b-instruct:free","google/gemini-2.0-flash-exp:free"]

# Hugging Face (Optional: for server-side LLM inference & embeddings)
HUGGINGFACE_API_KEY=your_huggingface_api_key
HF_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# External Search APIs (Optional)
GITHUB_TOKEN=your_github_personal_access_token
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain
